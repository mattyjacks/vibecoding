# GiveGigs Valley CAD 2 — Environment Variables
# Copy to .env (or inject into web/env.js for static hosting)

# Production Access Control
# Set a non-empty password to lock the web UI behind the Production Auth Gate.
# Leave empty in local development to bypass the lock screen.
VCAD2_PRODUCTION_PASSWORD=change-me-in-production
VCAD2_REQUIRE_AUTH=true

# OpenRouter Configuration (supports dirt-cheap to flagship models)
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Examples:
# - Dirt cheap: google/gemini-2.5-flash-lite, meta-llama/llama-3.1-8b-instruct
# - Balanced:   openai/gpt-6-luna-light, anthropic/claude-3.5-sonnet
# - Flagship:   openai/o3-pro, anthropic/claude-3.7-sonnet:thinking
OPENROUTER_MODEL=openai/gpt-6-luna-light

# Optional Server Port
PORT=8080
